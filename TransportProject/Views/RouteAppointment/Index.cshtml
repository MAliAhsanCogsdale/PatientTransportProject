@using TransportProject.ViewModels
@model RouteAppointmentListVM

@{
    ViewData["Title"] = "Route Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Route Appointments</h2>

    <a class="btn btn-primary"
       asp-controller="RouteAppointment"
       asp-action="ImportFile">
        Import File
    </a>
</div>

<!-- ================= FILTER FORM ================= -->
<form method="get" asp-action="Index" class="row mb-3">

    <div class="col-md-2">
        <input type="text"
               name="searchDriver"
               value="@Model.SearchDriver"
               class="form-control"
               placeholder="Driver" />
    </div>

    <div class="col-md-2">
        <input type="text"
               name="searchPatient"
               value="@Model.SearchPatient"
               class="form-control"
               placeholder="Patient" />
    </div>

    <div class="col-md-2">
        <input type="date"
               name="date"
               value="@(Model.Date.HasValue ? Model.Date.Value.ToString("yyyy-MM-dd") : "")"
               class="form-control" />
    </div>

    <div class="col-md-2 form-check mt-2">
        <input type="hidden" name="selectAll" value="false" />
        <input type="checkbox"
               name="selectAll"
               value="true"
        @(Model.SelectAll ? "checked" : "") />
        <label>Select All</label>
    </div>

    <div class="col-md-2">
        <select name="pageSize" class="form-control">
            <option value="50" selected="@(Model.PageSize == 50)">50</option>
            <option value="100" selected="@(Model.PageSize == 100)">100</option>
        </select>
    </div>

    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary w-100">
            Filter
        </button>
    </div>
</form>

<!-- ================= EXPORT BUTTON ================= -->
<form method="get"
      asp-action="ExportToExcel"
      asp-controller="RouteAppointment"
      class="mb-3">

    <input type="hidden" name="searchDriver" value="@Model.SearchDriver" />
    <input type="hidden" name="searchPatient" value="@Model.SearchPatient" />
    <input type="hidden" name="date" value="@(Model.Date.HasValue ? Model.Date.Value.ToString("yyyy-MM-dd") : "")" />
    <input type="hidden" name="selectAll" value="@Model.SelectAll" />

    <button type="submit" class="btn btn-success">
        Export Excel
    </button>
</form>

<!-- ================= TABLE ================= -->
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Sequence</th>
            <th>Driver</th>
            <th>Patient</th>
            <th>Pickup Time</th>
            <th>Pickup Address</th>
            <th>Hospital</th>
            <th>Drop Off Time</th>
            <th>Drop Off Address</th>
            
        </tr>
    </thead>

    <tbody>
        @if (Model.Items == null || !Model.Items.Any())
        {
            <tr>
                <td colspan="7" class="text-center">No records found.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.SequenceOrder</td>
                    <td>@item.DriverName</td>
                    <td>@item.PatientName</td>
                    <td>@item.PickupTime.ToString("g")</td>
                    <td>@item.PickupAddress</td>
                    <td>@item.HospitalName</td>
                    <td>@item.DropOffTime.ToString("g")</td>
                    <td>@item.DropOffAddress</td>
                    
                </tr>
            }
        }
    </tbody>
</table>

<!-- ================= PAGINATION ================= -->
@if (!Model.SelectAll)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                var qs =
                    $"?page={i}" +
                    $"&pageSize={Model.PageSize}" +
                    $"&searchDriver={Model.SearchDriver}" +
                    $"&searchPatient={Model.SearchPatient}" +
                    $"&date={(Model.Date.HasValue ? Model.Date.Value.ToString("yyyy-MM-dd") : "")}" +
                    $"&selectAll={Model.SelectAll}";

                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@qs">@i</a>
                </li>
            }
        </ul>
    </nav>
}